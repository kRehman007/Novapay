{
  "name": "account-service",
  "version": "1.0.0",
  "description": "NovaPay Account Service - User management, wallets, balance reads",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --coverage --detectOpenHandles --testPathPattern=account.test.js",
    "test:integration": "jest --coverage --detectOpenHandles --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:manual": "powershell -ExecutionPolicy Bypass -File .\\test-api.ps1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.0",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
