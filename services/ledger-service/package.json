{
  "name": "ledger-service",
  "version": "1.0.0",
  "description": "NovaPay Ledger Service - Double-entry bookkeeping, invariant checks, hash-chained audit logs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --coverage --detectOpenHandles ledger.test.js",
    "test:integration": "jest --coverage --detectOpenHandles ledger.integration.test.js",
    "test:watch": "jest --watch",
    "test:manual": "powershell -ExecutionPolicy Bypass -File .\\test-api.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
