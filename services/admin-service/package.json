{
  "name": "admin-service",
  "version": "1.0.0",
  "description": "NovaPay Admin Service - Dashboard, transaction search, dispute resolution, compliance",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --coverage --detectOpenHandles admin.test.js",
    "test:integration": "jest --coverage --detectOpenHandles admin.integration.test.js",
    "test:watch": "jest --watch",
    "test:manual": "powershell -ExecutionPolicy Bypass -File .\\test-api.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
